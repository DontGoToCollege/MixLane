<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS is what's installed. Retarget to net8.0-windows if you prefer; nothing here needs anything newer. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MixLane</AssemblyName>
    <RootNamespace>MixLane</RootNamespace>
    <Product>MixLane</Product>
    <Version>0.1.0</Version>
    <Company>-</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Self-contained single-file publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Snappier startup for a self-contained app -->
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decoding (MP3/WAV/AIFF/WMA/AAC/M4A/FLAC/ALAC + audio tracks of video files via Windows Media Foundation),
         playback (WASAPI), resampling and encoding. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Ogg Vorbis decoding (Media Foundation has no Vorbis decoder). -->
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

</Project>
